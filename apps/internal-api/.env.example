PORT=4002
DATABASE_URL_INTERNAL=postgresql://internal_api:CHANGE_ME@localhost:54322/postgres
DATABASE_URL_PORTAL=postgresql://vendor_api:CHANGE_ME@localhost:54322/postgres
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
PORTAL_SERVICE_KEY=
STORAGE_BUCKET=nexraah
# SUPABASE_SERVICE_ROLE_KEY — deliberately absent. See docs/specs/internal-spec/14-supabase-setup.md §4.

# Sign-in codes by email — Supabase Auth's "Send Email" hook calls
# POST /api/v1/auth/email-hook and the code goes out through Resend (free tier).
# SEND_EMAIL_HOOK_SECRET is the secret Supabase shows for the hook (v1,whsec_…).
SEND_EMAIL_HOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=Nexraah <no-reply@nexraah.in>
EMAIL_REPLY_TO=
EMAIL_LOGO_URL=https://nexraah-mono-repo.vercel.app/nexraah-logo.png

# Reading details off uploaded documents (the "Fetch" button on the verify form) and the
# assistant in the console both use this one key.
# Optional: without it Fetch says reading is not set up, and details are typed by hand as before.
# Documents are sent to the Anthropic API to be read.
ANTHROPIC_API_KEY=

# Whether identity papers — PAN card, Aadhaar card, address proof — may be read too.
# Off unless this says exactly `true`: turning it on sends those card images to the Anthropic API,
# which is a decision for whoever answers for how the company handles Aadhaar (NFR-04, R-04).
# On or off, an Aadhaar number is only ever returned and stored as its last four digits (BR-04),
# and only Compliance can have an identity paper already on file read.
OCR_READ_IDENTITY=
