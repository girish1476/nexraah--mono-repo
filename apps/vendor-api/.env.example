# internal-spec/14-supabase-setup.md §9. This app holds no database URL and
# no Supabase key of any kind — a driver or credential landing here is a CI
# failure (ADR-02 §5).

PORT=4001
INTERNAL_API_URL=http://localhost:4002/api/v1
PORTAL_SERVICE_KEY=            # must match internal-api's PORTAL_SERVICE_KEY, 32 bytes random
CORS_ORIGIN=http://localhost:3001
