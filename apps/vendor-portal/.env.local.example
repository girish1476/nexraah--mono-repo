# Copy to .env.local (gitignored) for local dev.

# 1 = serve every /portal/* call from src/lib/mock.ts fixtures (FE.md).
# Default is off — production must never silently fall back to fixtures.
NEXT_PUBLIC_MOCK=1

# Override only to point at a non-default vendor-api host/port.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4001/api/v1
