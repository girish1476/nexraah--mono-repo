# Copy to .env.local (gitignored). Where vendor-portal's dev server is
# reachable from THIS device, not from this machine.
#
# Android emulator (AVD) — 10.0.2.2 is the emulator's alias for the host
# machine's localhost:
EXPO_PUBLIC_PORTAL_BASE_URL=http://10.0.2.2:3001
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001/api/v1

# Physical Android phone via Expo Go, same Wi-Fi as this machine — use the
# dev machine's LAN IP instead of 10.0.2.2/localhost:
# EXPO_PUBLIC_PORTAL_BASE_URL=http://192.168.1.23:3001
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.23:3001/api/v1

# No real vendor-api upload endpoint exists yet (see the plan's Phase 1
# scope) — capture screens mock the upload response until it does.
EXPO_PUBLIC_MOCK=1
