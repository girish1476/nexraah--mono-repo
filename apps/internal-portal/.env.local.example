# Copy to .env.local (gitignored) for local dev.

# 0 = hit the real internal-api instead of src/mocks. Defaults to on ('1')
# since internal-api is still being built — most local dev wants mocks.
#
# This flag also decides where sign-in goes. With mocks ON, /signin checks the
# six fixture accounts in src/mocks/db.ts (password: nexraah) and mints its own
# token — no Supabase needed. With mocks OFF, the same form posts the password
# to Supabase Auth, which issues the JWT internal-api verifies against JWKS
# (part 14 §4.1). internal-api never issues a token in either mode.
NEXT_PUBLIC_USE_MOCKS=1

# Override only to point at a non-default internal-api host/port.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4002/api/v1

# Required only when NEXT_PUBLIC_USE_MOCKS=0 — sign-in has nowhere to go
# without them. Must be the same project internal-api validates against, or
# every token this app obtains will be rejected as the wrong issuer.
#
# Before real-mode sign-in works, that project also needs an auth account per
# internal user, with users.auth_user_id pointing at it. `supabase db reset`
# does both from supabase/seed.sql. Without the link a sign-in succeeds and
# then fails as "This principal holds no internal role."
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54330
NEXT_PUBLIC_SUPABASE_ANON_KEY=
