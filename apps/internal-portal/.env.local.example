# Copy to .env.local (gitignored) for local dev.

# 0 = hit the real internal-api instead of src/mocks. Defaults to on ('1')
# since internal-api is still being built — most local dev wants mocks.
NEXT_PUBLIC_USE_MOCKS=1

# Override only to point at a non-default internal-api host/port.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4002/api/v1
