node_modules
dist
# Every Next build dir, however it is named. The demo host builds into
# .next-build / .next-prod-stage via NEXT_DIST_DIR so a production build can
# run while a dev server holds .next — each one is a few hundred generated
# files, and they were landing in `git status` as if they were work.
.next*
.hosting
build
coverage
*.log
.env
.env.local
.DS_Store
.turbo
test-results
playwright-report
blob-report
playwright/.cache
.vercel

# Playwright fixture session written by e2e/global-setup.ts — regenerated
# every run, and never a real credential.
e2e/.auth

.env*
